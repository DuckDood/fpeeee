	${CC} obj/types.c.o obj/physics.c.o obj/shape_generators.c.o obj/spatial.c.o obj/constraints.c.o obj/helpers.c.o obj/matrix.c.o obj/fluid.c.o -o build/fluid.html --shell-file web/shell.html -sALLOW_MEMORY_GROWTH -sEXPORTED_RUNTIME_METHODS=[requestFullscreen,ccall,cwrap] -sEXPORTED_FUNCTIONS=[_get_option,_main] -lm -lSDL3 -g
else
	${CC} obj/types.c.o obj/physics.c.o obj/shape_generators.c.o obj/spatial.c.o obj/constraints.c.o obj/helpers.c.o obj/matrix.c.o obj/fluid.c.o -o build/fluid.html --shell-file web/shell.html -sALLOW_MEMORY_GROWTH -sEXPORTED_RUNTIME_METHODS=[requestFullscreen,ccall,cwrap] -sEXPORTED_FUNCTIONS=[_get_option,_main] -lm -lSDL3 -g
